# Serves the built assets and proxies /api to scene-service.
#
# This mirrors what vite.config.ts does in development, and for the same reason:
# the browser sees one origin, so the backend never needs CORS headers.
#
# SCENE_URL is substituted at container start by the nginx image's own envsubst
# step, which is what makes one image work in both places: compose passes
# http://scene:8080, Cloud Run passes the scene-service URL. Substituting at
# start rather than at build also means proxy_pass ends up with a literal host,
# so nginx does not need a `resolver` directive.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${SCENE_URL};

        # Cloud Run routes on the Host header, so it has to match the target
        # rather than the browser's host. $proxy_host is whatever proxy_pass
        # resolved to, which is correct in both environments.
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;

        # An access-window sweep over a long horizon takes a while.
        proxy_read_timeout 120s;
    }

    # Hashed filenames, so these can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths are routes, not missing files.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
